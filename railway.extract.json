{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": ["/railway.extract.json"]
  },
  "deploy": {
    "startCommand": "python extract_runner.py",
    "cronSchedule": "0 9 * * *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 2
  }
}

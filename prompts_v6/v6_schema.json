{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NYCEats extraction v6 round 4 (comment mode; thread mode adds an integer id as the first mention property)",
  "type": "object",
  "properties": {
    "mentions": {"type": "array", "items": {"$ref": "#/$defs/mention"}}
  },
  "required": ["mentions"],
  "additionalProperties": false,
  "$defs": {
    "level": {
      "type": ["string", "null"],
      "enum": ["superlative_praise", "praise", "mixed", "knock", "extreme_knock", null]
    },
    "dish": {
      "type": "object",
      "properties": {
        "dish": {"type": "string"},
        "level": {"$ref": "#/$defs/level"},
        "avoid": {"type": "boolean"}
      },
      "required": ["dish", "level", "avoid"],
      "additionalProperties": false
    },
    "note": {
      "type": "object",
      "properties": {
        "about": {"type": "string"},
        "text": {"type": "string"}
      },
      "required": ["about", "text"],
      "additionalProperties": false
    },
    "mention": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "named_in": {"type": "string", "enum": ["comment", "context"]},
        "kind": {
          "type": "string",
          "enum": ["restaurant", "bar", "cafe", "bakery", "deli", "truck_or_cart", "market_stall", "food_hall",
                   "grocery", "brand", "venue", "company", "other"]
        },
        "location": {"type": ["string", "null"]},
        "experience": {"type": "string", "enum": ["firsthand", "secondhand", "none"]},
        "dishes": {"type": "array", "items": {"$ref": "#/$defs/dish"}},
        "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}},
        "aspects": {
          "type": "object",
          "properties": {
            "taste": {"$ref": "#/$defs/level"},
            "value": {"$ref": "#/$defs/level"},
            "service": {"$ref": "#/$defs/level"},
            "atmosphere": {"$ref": "#/$defs/level"},
            "wait": {"$ref": "#/$defs/level"}
          },
          "required": ["taste", "value", "service", "atmosphere", "wait"],
          "additionalProperties": false
        },
        "opinion": {"type": "string", "enum": ["none", "endorse", "stated"]},
        "overall": {"$ref": "#/$defs/level"},
        "avoid": {"type": "boolean"},
        "timeframe": {"type": "string", "enum": ["current", "past"]},
        "trend": {"type": ["string", "null"], "enum": ["declined", "improved", null]},
        "status": {"type": ["string", "null"], "enum": ["closed", "moved", "opened", null]},
        "price": {
          "type": ["string", "null"],
          "enum": ["very_cheap", "cheap", "moderate", "expensive", "very_expensive", null]
        },
        "tags": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["name", "named_in", "kind", "location", "experience", "dishes", "notes", "aspects",
                   "opinion", "overall", "avoid", "timeframe", "trend", "status", "price", "tags"],
      "additionalProperties": false
    }
  }
}
